# Copy to .env and fill in your secrets (.env is gitignored).

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
NODE_ENV="development"
# Absolute path to this repo. `mastra dev`/`mastra start` run from .mastra/output,
# so migrations, skills, and the DuckDB file resolve against this, not cwd.
PROJECT_ROOT="/path/to/gorkie"

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
# Bind address and port. Keep loopback: the tunnel is the only public way in.
# HOST="127.0.0.1"
# PORT="4111"
# Bearer token every non-public route requires (Slack webhook and /health stay
# public). Required in production and before tunnelling: openssl rand -hex 32
GORKIE_API_TOKEN=""
# Public https origin of the bot. Required for the GitHub sign-in (OAuth
# redirects to <PUBLIC_BASE_URL>/oauth/github/callback). In development,
# http://localhost:4111 works as long as the browser reaches that port.
# PUBLIC_BASE_URL="https://your-host"

# ----------------------------------------------------------------------------
# Slack
# ----------------------------------------------------------------------------
# Signing secret (Basic Information > App Credentials), verifies webhook requests
SLACK_SIGNING_SECRET="your-signing-secret"
# Bot User OAuth Token (OAuth & Permissions)
SLACK_BOT_TOKEN="xoxb-your-bot-token"
# Slack user token, not the bot token, used for public-channel search. Mint it
# with search:read.public only. gorkie refuses to use it if it also grants
# search:read.im, search:read.mpim, or search:read.private, since those can read
# DMs and private channels. See docs/slack-search.md.
SLACK_USER_TOKEN="xoxp-your-user-token"
# Optional opt-in allowlist: gate access to members of this channel id. Unset lets everyone in.
OPT_IN_CHANNEL=""
# Moderation: channel id of the gorkie-logs channel where ban/unban cards are posted.
LOGS_CHANNEL=""
# Comma-separated Slack user ids allowed to /ban and /unban (e.g. "U0123ABC,U0456DEF").
MODERATORS=""

# ----------------------------------------------------------------------------
# Models
# ----------------------------------------------------------------------------
# Hack Club
HACKCLUB_API_KEY="your-hackclub-api-key"
# OpenCode Go (Zen). https://opencode.ai/docs/zen
OPENCODE_API_KEY="your-opencode-api-key"

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gorkie"

# ----------------------------------------------------------------------------
# Observability (Langfuse). Required: the agent refuses to start without a
# tracing exporter. https://cloud.langfuse.com -> Settings -> API keys
# ----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
# Self-hosted Langfuse only. Defaults to https://cloud.langfuse.com.
LANGFUSE_BASE_URL=""

# ----------------------------------------------------------------------------
# Code Sandbox (E2B). https://e2b.dev/
# ----------------------------------------------------------------------------
E2B_API_KEY="e2b_..."

# ----------------------------------------------------------------------------
# Credential encryption. Encrypts the GitHub and MCP tokens people connect,
# at rest. 32 bytes, base64. Generate one with: openssl rand -base64 32
# ----------------------------------------------------------------------------
CREDENTIALS_KEY="your-base64-32-byte-key"

# ----------------------------------------------------------------------------
# GitHub. Register a GitHub App with the callback URL
# <PUBLIC_BASE_URL>/oauth/github/callback (see docs/github-app.md). People
# connect from App Home; Gorkie then acts as them, limited to the repos they
# installed it on.
# https://github.com/settings/apps/new
# ----------------------------------------------------------------------------
GITHUB_APP_SLUG="gorkie-ai"
GITHUB_APP_CLIENT_ID="Iv23li..."
GITHUB_APP_CLIENT_SECRET="your-app-client-secret"

# Optional brokered sandbox credentials. The key stays on the host; E2B network
# rules attach it to matching outbound sandbox requests.
AGENTMAIL_API_KEY=""

# ----------------------------------------------------------------------------
# Web search (Exa). https://exa.ai/
# ----------------------------------------------------------------------------
EXA_API_KEY="your-exa-api-key"

# ----------------------------------------------------------------------------
# Slack emoji upload (Hack Club proxy). Optional. Enables upload_emoji.
# https://hackclub-slack-emoji-proxy.vercel.app
# ----------------------------------------------------------------------------
EMOJI_PROXY_TOKEN=""
