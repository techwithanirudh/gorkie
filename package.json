{
  "name": "gorkie",
  "license": "AGPL-3.0-only",
  "description": "An AI assistant for Slack, built on Mastra.",
  "type": "module",
  "module": "src/mastra/index.ts",
  "private": true,
  "scripts": {
    "build": "mastra build",
    "build:template": "bun run src/mastra/workspace/build-template.ts",
    "check": "ultracite check .",
    "check:spelling": "cspell -c .cspell.jsonc --no-progress --no-summary --no-must-find-files --unique --cache .",
    "check:unsafe": "ultracite fix --unsafe .",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "mastra dev --request-context-presets ./studio/request-context.json",
    "dev:e2e": "bash ./scripts/dev-e2e.sh",
    "dev:tunnel": "untun tunnel http://127.0.0.1:4111",
    "fix": "ultracite fix .",
    "postbuild": "bun run scripts/postbuild.ts && cd .mastra/output && bun install",
    "prepare": "lefthook install",
    "start": "mastra start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/provider-utils": "^5.0.26",
    "@chat-adapter/slack": "^4.41.0",
    "@github-tools/sdk": "^1.11.1",
    "@langfuse/client": "^5.11.1",
    "@mastra/core": "1.69.0",
    "@mastra/deployer": "^1.69.0",
    "@mastra/duckdb": "^1.10.0",
    "@mastra/e2b": "^0.12.1",
    "@mastra/factory": "0.17.0",
    "@mastra/langfuse": "^1.5.8",
    "@mastra/loggers": "^1.3.2",
    "@mastra/mcp": "1.18.0",
    "@mastra/memory": "^1.31.0",
    "@mastra/observability": "^1.17.9",
    "@mastra/pg": "^1.26.0",
    "@mastra/server": "^1.69.0",
    "@octokit/oauth-methods": "^6.0.4",
    "@octokit/request": "^10.0.15",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@slack/web-api": "^8.1.1",
    "@t3-oss/env-core": "^0.13.11",
    "@vercel/connect": "^2.0.4",
    "ai": "^7.0.99",
    "chat": "^4.41.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "e2b": "^2.36.1",
    "exa-js": "^2.16.3",
    "hono": "4.13.8",
    "ipaddr.js": "^2.5.0",
    "mime-types": "^3.0.2",
    "oauth4webapi": "3.8.8",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@opentui/core": "0.5.11",
    "@types/bun": "latest",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24",
    "cspell": "^10.0.1",
    "drizzle-kit": "1.0.0-rc.4",
    "lefthook": "^2.1.10",
    "mastra": "^1.31.1",
    "typescript": "^6.0.3",
    "ultracite": "7.9.4",
    "untun": "^0.2.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "patchedDependencies": {
    "@mastra/core@1.69.0": "patches/@mastra+core@1.69.0.patch"
  }
}
